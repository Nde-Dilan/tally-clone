{
  "name": "quill",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source forms platform — clone-and-run on SQLite, deploy anywhere.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm run build:packages && pnpm run db:setup && turbo run dev",
    "dev:pg": "docker compose up -d --wait db && cross-env DATABASE_URL=postgres://quill:quill@localhost:${PG_PORT:-5432}/quill pnpm run db:setup && cross-env DATABASE_URL=postgres://quill:quill@localhost:${PG_PORT:-5432}/quill turbo run dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @quill/db migrate",
    "db:seed": "pnpm --filter @quill/db seed",
    "db:reset": "pnpm --filter @quill/db reset",
    "db:setup": "pnpm run db:migrate && pnpm run db:seed",
    "changeset": "changeset",
    "publish-gate": "bash scripts/publish-gate.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "qa": "playwright test -c qa/playwright.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "better-sqlite3",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
