{
  "name": "@quill/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The dForms MCP server: task-shaped tools over a host-provided forms backend, a hardened Streamable HTTP door, and the agent guide (config JSON Schema, rules, examples).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./guide": { "types": "./dist/guide/index.d.ts", "import": "./dist/guide/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@quill/engine": "workspace:*",
    "@quill/shared": "workspace:*",
    "@quill/types": "workspace:*",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2",
    "zod4": "npm:zod@^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@quill/config": "workspace:*",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
